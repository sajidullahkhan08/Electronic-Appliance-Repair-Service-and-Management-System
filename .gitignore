# ============================================================
# .gitignore — ElectroFix
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.so
*.pyd
*.dll
*.egg-info/
.eggs/
*.egg
*.log
.pytest_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Flask / SQLite ---
*.db
*.sqlite3
*.sqlite
instance/

# --- Environment / secrets (NEVER commit these) ---
.env
# Keep .env.example (it has no real secrets, just placeholders)
!.env.example

# --- Node / Frontend build artifacts ---
node_modules/
.npm/
.yarnrc*
.pnpm-store/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# --- Project specific ---
backend/__pycache__/
